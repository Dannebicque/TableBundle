{
  "name": "dannebicque/table-bundle",
  "description": "Bundle generant un tableau dynamique depuis Symfony",
  "type": "symfony-bundle",
  "license": "MPL-2.0",
  "homepage": "https://github.com/Dannebicque/TableBundle",
  "autoload": {
    "psr-4": {
      "Dannebicque\\TableBundle\\": "src/"
    }
  },
  "keywords": [
    "symfony-ux"
  ],
  "authors": [
    {
      "name": "David Annebicque",
      "email": "david.annebicque@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/deprecation-contracts": "^3.5",
    "symfony/form": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/options-resolver": "^7.4 || ^8.0",
    "symfony/property-access": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/stimulus-bundle": "^2.31 || ^3.0",
    "symfony/translation": "^7.4 || ^8.0",
    "symfony/twig-bridge": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "twig/twig": "^3.15"
  },
  "require-dev": {
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "doctrine/orm": "^3.3",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "symfony/asset-mapper": "^7.4 || ^8.0",
    "symfony/security-csrf": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "suggest": {
    "doctrine/orm": "Required by EntityAdapter, SelectColumnType and SelectChangeType",
    "doctrine/doctrine-bundle": "Required together with doctrine/orm"
  },
  "autoload-dev": {
    "psr-4": {
      "Dannebicque\\TableBundle\\Tests\\": "tests/"
    }
  }
}
