<my-toolbar theme="default">
    <form class="toolbar-item-container">
        {%- for child in form -%}
            <div class="toolbar-item-filter toolbar-item">
                {{- form_row(child) -}}
            </div>
        {%- endfor -%}
        <div class="toolbar-item-separator"></div>
        {%- for child in widget -%}
            <div class="toolbar-item-widget toolbar-item">
                {{- render_widget(child) -}}
            </div>
        {%- endfor -%}
    </form>
    <div class="toolbar-alert"></div>
</my-toolbar>
